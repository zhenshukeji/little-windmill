# ============ 数据库 ============
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kindergarten
DB_USERNAME=root
DB_PASSWORD=your-db-password

# ============ Redis ============
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=5

# ============ JWT ============
TOKEN_SECRET=change-me-to-a-strong-random-string-min-32-chars
JWT_SECRET=change-me-too

# ============ 微信小程序 ============
WX_APP_ID=your-wechat-app-id
WX_APP_SECRET=your-wechat-app-secret

# ============ 阿里云短信（可选） ============
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=

# ============ 文件上传 ============
UPLOAD_PATH=./data/files
FILE_URL_PREFIX=http://localhost:8184/files

# ============ Docker Compose ============
DB_ROOT_PASSWORD=your-mysql-root-password
