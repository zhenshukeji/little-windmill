# ============================================================
# 风车智慧幼教社区版 环境变量示例（复制为 .env 后填写真实值）
# 真实凭据禁止提交进仓库；本文件仅含占位符
# ============================================================

# —— 数据库 / Redis（家长端与管理端共用同一套变量名） ——
DB_URL=jdbc:mysql://127.0.0.1:3306/kindergarten?useUnicode=true&characterEncoding=utf8&serverTimezone=GMT%2B8
DB_USERNAME=
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# —— 令牌 ——
TOKEN_SECRET=            # 生产环境必须设置为强随机串（>=32 字符）

# —— 微信小程序（真实登录必需；未配置时登录不可用，不做绕过） ——
WX_APP_ID=
WX_APP_SECRET=

# —— 阿里云短信（验证码下发；未配置时发送显式失败） ——
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=

# —— 文件上传（自托管本地存储） ——
UPLOAD_PATH=./data/files
FILE_URL_PREFIX=http://127.0.0.1:8184/files

# —— 可选 ——
SENTRY_DSN=
DRUID_CONSOLE_PASSWORD=
APP_USER_PASSWORD=
SWAGGER_PASSWORD=
